#!/bin/sh /etc/rc.common
# OpenWrt Roaming Manager service
#  - boot: restores the previous configuration if a roamctl change was
#    interrupted by a power loss/reboot before it was confirmed
#  - daemon (only when needed): re-installs 802.11k neighbor lists after
#    hostapd restarts and runs the native steering backend

START=99
STOP=10
USE_PROCD=1

boot() {
	/usr/sbin/roamctl boot
	start "$@"
}

start_service() {
	[ "$(uci -q get roamctl.global.daemon)" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/roamctl daemon
	procd_set_param respawn 3600 10 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger roamctl wireless
}
