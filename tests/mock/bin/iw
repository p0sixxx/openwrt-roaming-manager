#!/bin/sh
# Mock iw: phy info from $MOCK_DIR/iw/phy/<phy>.info, dev list generated by wifi
case "$1" in
phy)
	if [ -z "${2:-}" ]; then
		for f in "$MOCK_DIR"/iw/phy/*.info; do [ -f "$f" ] && cat "$f"; done
	else
		[ -f "$MOCK_DIR/iw/phy/$2.info" ] || { echo "command failed: No such device (-19)" >&2; exit 237; }
		cat "$MOCK_DIR/iw/phy/$2.info"
	fi
	;;
list) for f in "$MOCK_DIR"/iw/phy/*.info; do [ -f "$f" ] && cat "$f"; done ;;
dev)
	if [ -z "${2:-}" ]; then cat "$MOCK_DIR/iw/dev.txt" 2>/dev/null; exit 0; fi
	ifn=$2
	case "${3:-}" in
	info)
		awk -v i="$ifn" '/^\tInterface /{p=($2==i)} p' "$MOCK_DIR/iw/dev.txt" | grep -q . || exit 237
		awk -v i="$ifn" '/^\tInterface /{p=($2==i)} p' "$MOCK_DIR/iw/dev.txt"
		;;
	scan) [ -f "$MOCK_DIR/iw/scan/$ifn" ] && cat "$MOCK_DIR/iw/scan/$ifn" || { echo "command failed: Operation not supported (-95)" >&2; exit 161; } ;;
	station)
		f="$MOCK_DIR/iw/station/$ifn"
		[ -f "$f" ] || exit 0
		if [ "${4:-}" = get ]; then awk -v m="$5" '/^Station /{p=(tolower($2)==tolower(m))} p' "$f"; else cat "$f"; fi
		;;
	*) exit 1 ;;
	esac
	;;
*) exit 1 ;;
esac
